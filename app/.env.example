# Postgres connection string.
# Works with Neon, Supabase, Railway or a self-hosted instance.
# Neon and Supabase require ?sslmode=require at the end.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session signing secrets. Generate each one separately with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# These MUST be different values - the app refuses to start otherwise.
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=

# Where new-order notifications are sent (the shop owner's inbox).
# Can be overridden at runtime under Admin -> Settings without a redeploy.
ORDER_NOTIFY_EMAIL=orders@example.com

# Optional. The From address on outgoing mail. Defaults to ORDER_NOTIFY_EMAIL.
ORDER_FROM_EMAIL=

# SMTP connection string, e.g. smtps://user:pass@smtp.provider.com:465
# For local testing run `npx maildev` and use smtp://localhost:1025
SMTP_URL=smtp://localhost:1025

# Where product images are written. Relative to the project root.
UPLOAD_DIR=./public/uploads

# Payment methods offered in the order form. JSON array, at least one entry.
# The receive (wallet) address for each method is NOT set here - the admin
# sets it under Admin -> Settings, stored in the database.
PAYMENT_METHODS=[{"id":"usdc-base","label":"USDC (Base)","chain":"base","token":"USDC"}]

# Number and currency formatting. en-IE gives "EUR1,234.56"; de-DE gives "1.234,56 EUR".
STORE_LOCALE=en-IE
STORE_CURRENCY=EUR

# Public base URL, used in email links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
